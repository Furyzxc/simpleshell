#include <stdio.h>

#ifndef HELP_H
#define HELP_H
void help() {
  printf("cd <dir>     change the current directory");
  printf("clr          clear the screen");
  printf("dir <dir>    list the contents of directory <dir>");
  printf("environ      list all environment variables");
  printf("echo <text>  display <text> on the screen");
  printf("help         display this help manual");
  printf("pause        pause operation of the shell");
  printf("quit         quit the shell");
}
#endif
