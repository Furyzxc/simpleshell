#include <stdio.h>
#include <stdlib.h>

char **slice_strings(char **arr, int start) {
    if (!arr || start >= end) return NULL;

    // Count how many elements
    int count = 0;
    for (int i = start; i < end && arr[i] != NULL; i++) count++;

    char **slice = malloc((count + 1) * sizeof(char *));
    if (!slice) return NULL;

    for (int i = 0; i < count; i++)
        slice[i] = arr[start + i]; // just copy pointer

    slice[count] = NULL; // null-terminate
    return slice;
}
